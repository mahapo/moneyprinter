{
  "name": "@moneyprinter/backend",
  "version": "0.4.0",
  "main": "index.js",
  "repository": "https://github.com/mahapo/decentralex-bots.git",
  "author": "Manuel Haller Polo <manuel@wondrous.ch>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly ./src/server.ts",
    "trader": "ts-node-dev --respawn --transpileOnly ./src/trader.ts",
    "binance": "ts-node-dev --respawn --transpileOnly ./src/binance.ts",
    "multitrader": "ts-node-dev --respawn --transpileOnly ./src/multitrader.ts",
    "backtest": "ts-node-dev --respawn --transpileOnly ./src/backtest.ts",
    "etoro": "ts-node-dev --respawn --transpileOnly ./src/etoro.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "ping": "curl -o /dev/null -s -w 'Total: %{time_total}s\n' https://api.bybit.com/v2/public/orderBook/L2?symbol=BTCUSD",
    "pm2": "pm2 start npm --name \"bybit\" -- run \"trader\" --watch",
    "pm2:demo": "SANDBOX=true pm2 start npm --name \"bybit:testnet\" -- run \"trader\" --watch",
    "pm2:multi": "SANDBOX=true pm2 start npm --name \"bybit:${INDEX}multi\" -- run \"multitrader\" --watch"
  },
  "dependencies": {
    "@sentry/node": "5.27.4",
    "@slack/events-api": "^2.3.4",
    "@slack/web-api": "^5.13.0",
    "axios-cache-adapter": "^2.5.0",
    "ccxt": "^1.38.4",
    "colors": "^1.4.0",
    "commander": "^6.2.0",
    "csv-parser": "^2.3.3",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "kill-port": "^1.6.1",
    "module-alias": "^2.2.2",
    "request": "^2.88.2",
    "slackbots": "^1.2.0",
    "socket.io": "^3.0.3",
    "socketio-wildcard": "^2.0.0",
    "tulind": "^0.8.18",
    "ws": "^7.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/node": "^7.12.6",
    "@babel/preset-env": "^7.12.1",
    "@types/consola": "^2.2.5",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^26.0.15",
    "@types/koa": "^2.11.6",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-router": "^7.4.1",
    "@types/node": "^14.14.9",
    "@types/source-map-support": "^0.5.3",
    "csv-writer": "^1.6.0",
    "jest": "^26.6.3",
    "nodemon": "^2.0.6",
    "onchange": "^7.1.0",
    "serve": "^11.3.2",
    "source-map-support": "^0.5.19",
    "ts-jest": "^26.4.4",
    "ts-node-dev": "^1.0.0",
    "winston": "^3.3.3",
    "winston-transport-sentry-node": "^0.7.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}
