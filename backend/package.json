{
  "name": "@moneyprinter/backend",
  "version": "0.1.0",
  "main": "index.js",
  "repository": "https://github.com/mahapo/decentralex-bots.git",
  "author": "Manuel Haller Polo <manuel@wondrous.ch>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly ./src/server.ts",
    "trader": "ts-node-dev --respawn --transpileOnly ./src/trader.ts",
    "multitrader": "ts-node-dev --respawn --transpileOnly ./src/multitrader.ts",
    "backtest": "ts-node-dev --respawn --transpileOnly ./src/backtest.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "ping": "curl -o /dev/null -s -w 'Total: %{time_total}s\n' https://api.bybit.com/v2/public/orderBook/L2?symbol=BTCUSD",
    "pm2": "pm2 start npm --name \"bybit\" -- run \"trader\"",
    "pm2:demo": "SANDBOX=true pm2 start npm --name \"bybit:testnet\" -- run \"trader\"",
    "pm2:multi": "SANDBOX=true pm2 start npm --name \"bybit:${INDEX}multi\" -- run \"multitrader\""
  },
  "dependencies": {
    "@sentry/node": "5.15.5",
    "@slack/events-api": "^2.3.2",
    "@slack/web-api": "^5.8.1",
    "ccxt": "^1.27.29",
    "colors": "^1.4.0",
    "commander": "^5.1.0",
    "csv-parser": "^2.3.2",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "kill-port": "^1.6.0",
    "module-alias": "^2.2.2",
    "request": "^2.88.2",
    "slackbots": "^1.2.0",
    "socket.io": "^2.3.0",
    "socketio-wildcard": "^2.0.0",
    "tulind": "^0.8.18",
    "ws": "^7.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.9.6",
    "@babel/node": "^7.8.7",
    "@babel/preset-env": "^7.9.6",
    "@types/consola": "^2.2.5",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^25.2.2",
    "@types/koa": "^2.11.3",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-router": "^7.4.0",
    "@types/node": "^14.0.1",
    "@types/source-map-support": "^0.5.1",
    "csv-writer": "^1.6.0",
    "jest": "^26.0.1",
    "onchange": "^7.0.2",
    "serve": "^11.3.0",
    "source-map-support": "^0.5.19",
    "ts-jest": "^26.0.0",
    "ts-node-dev": "^1.0.0-pre.44",
    "winston": "^3.2.1",
    "winston-transport-sentry-node": "^0.3.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  }
}