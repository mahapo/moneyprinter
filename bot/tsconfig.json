{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "outDir": "./dist",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["es2016", "esnext.asynciterable"],
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
    // "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "../packages/runners/src/TraderFutures.ts"
  ],
  "exclude": ["node_modules", "../ccxt/**/*", "**/*.test.ts", "**/*.spec.ts"]
}
